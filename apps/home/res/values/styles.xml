<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Home" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@drawable/graphite</item>
        <item name="android:colorAccent">#FFE9EAEC</item>
        <item name="android:colorBackground">#FF0E131A</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="Theme.Home.Edit" />

    <style name="Theme.Home.Dialog" parent="@android:style/Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.55</item>
        <item name="android:colorAccent">#FFE9EAEC</item>
    </style>
</resources>
